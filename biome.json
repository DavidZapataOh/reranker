{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/next-env.d.ts",
      "!.impeccable",
      "!assets",
      "!**/public",
      "!**/*.md"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended",
      "drizzle": "recommended"
    },
    "rules": { "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" } }
  },
  "overrides": [
    {
      "includes": ["**/*.contract.test.ts"],
      "linter": { "rules": { "suspicious": { "noSkippedTests": "error" } } }
    },
    {
      "includes": [
        "apps/web/src/**",
        "packages/*/src/**",
        "!packages/testing/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": { "@reranker/testing": "Test-only package." },
                "patterns": [
                  {
                    "group": ["@reranker/testing/*", "**/testing/src/**"],
                    "message": "Test-only package."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "path": "./tools/biome/no-conditional-contract-tests.grit",
      "includes": ["**/*.contract.test.ts"]
    }
  ]
}
