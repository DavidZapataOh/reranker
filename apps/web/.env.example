# Runtime environment: development, preview or production (Config)
APP_ENV=

# Better Stack heartbeat URL pinged by the daily job (Secret)
BETTERSTACK_HEARTBEAT_DAILY_URL=

# GitHub token that reads Actions billing for the daily digest (Secret)
GITHUB_BILLING_READ_TOKEN=

# Minimum level written to the logs (Config)
LOG_LEVEL=

# Microsoft Clarity project id (Config)
NEXT_PUBLIC_CLARITY_ID=

# Google Analytics 4 measurement id (Config)
NEXT_PUBLIC_GA_ID=

# PostHog project key for the browser (Config)
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog cloud region, us unless the project lives in the EU (Config)
NEXT_PUBLIC_POSTHOG_REGION=

# Inbox that receives operational alerts (Config)
OPS_ALERT_EMAIL=

# PostHog personal API key for releases and source maps (Secret)
POSTHOG_API_KEY=

# PostHog ingestion host, e.g. https://us.i.posthog.com (Config)
POSTHOG_HOST=

# PostHog project id for API queries (Config)
POSTHOG_PROJECT_ID=

# PostHog project token for server events and flags (Config)
POSTHOG_PROJECT_TOKEN=

# PostHog key with query read scope for the daily digest (Secret)
POSTHOG_QUERY_READ_KEY=
