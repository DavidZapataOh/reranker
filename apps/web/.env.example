# Runtime environment: development, preview or production (Config)
APP_ENV=

# Better Stack heartbeat URL pinged by the daily job (Secret)
BETTERSTACK_HEARTBEAT_DAILY_URL=

# Failure ratio that opens a breaker (Config)
BREAKER_FAILURE_RATIO=

# Calls in the window before a breaker can open (Config)
BREAKER_MIN_CALLS=

# How long an open breaker stays open, in ms (Config)
BREAKER_OPEN_MS=

# Bright Data concurrent requests (Config)
BRIGHTDATA_MAX_IN_FLIGHT=

# Bearer that Vercel Cron and operators send to protected routes (Secret)
CRON_SECRET=

# DataForSEO API login (Secret)
DATAFORSEO_LOGIN=

# DataForSEO concurrent requests (Config)
DATAFORSEO_MAX_IN_FLIGHT=

# DataForSEO API password (Secret)
DATAFORSEO_PASSWORD=

# DataForSEO requests per minute (Config)
DATAFORSEO_RPM=

# Gemini API concurrent requests (Config)
GEMINI_MAX_IN_FLIGHT=

# Gemini API requests per minute of the project tier (Config)
GEMINI_RPM=

# Gemini API tokens per minute of the project tier (Config)
GEMINI_TPM=

# GitHub token that reads Actions billing for the daily digest (Secret)
GITHUB_BILLING_READ_TOKEN=

# Google Places concurrent requests (Config)
GOOGLE_PLACES_MAX_IN_FLIGHT=

# Google Places queries per minute (Config)
GOOGLE_PLACES_QPM=

# Longest a step waits for provider capacity, in ms (Config)
JOBS_MAX_INLINE_WAIT_MS=

# Minimum level written to the logs (Config)
LOG_LEVEL=

# Neon API key that reads usage of both projects (Secret)
NEON_API_KEY=

# Neon project id of reranker-nonprod (Config)
NEON_NONPROD_PROJECT_ID=

# Neon project id of reranker-prod (Config)
NEON_PROJECT_ID=

# Microsoft Clarity project id (Config)
NEXT_PUBLIC_CLARITY_ID=

# Google Analytics 4 measurement id (Config)
NEXT_PUBLIC_GA_ID=

# PostHog project key for the browser (Config)
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog cloud region, us unless the project lives in the EU (Config)
NEXT_PUBLIC_POSTHOG_REGION=

# OpenAI concurrent requests (Config)
OPENAI_MAX_IN_FLIGHT=

# OpenAI requests per minute of the project tier (Config)
OPENAI_RPM=

# OpenAI tokens per minute of the project tier (Config)
OPENAI_TPM=

# Inbox that receives operational alerts (Config)
OPS_ALERT_EMAIL=

# PostHog personal API key for releases and source maps (Secret)
POSTHOG_API_KEY=

# PostHog project secret API key with feature_flag:read, for local flag evaluation (Secret)
POSTHOG_FEATURE_FLAGS_KEY=

# PostHog ingestion host, e.g. https://us.i.posthog.com (Config)
POSTHOG_HOST=

# PostHog project id for API queries (Config)
POSTHOG_PROJECT_ID=

# PostHog project token for server events and flags (Config)
POSTHOG_PROJECT_TOKEN=

# PostHog key with query read scope for the daily digest (Secret)
POSTHOG_QUERY_READ_KEY=

# Daily Resend email quota (Config)
QUOTA_RESEND_EMAILS_DAILY=

# Resend daily quota split as critical/high/normal/low (Config)
QUOTA_RESEND_EMAILS_SPLIT=

# Daily Anthropic spend cap, in USD (Config)
SPEND_CAP_DAILY_ANTHROPIC_USD=

# Daily benchmark spend cap, in USD (Config)
SPEND_CAP_DAILY_BENCHMARK_USD=

# Daily Bright Data spend cap, in USD (Config)
SPEND_CAP_DAILY_BRIGHTDATA_USD=

# Daily provider contract test spend cap, in USD (Config)
SPEND_CAP_DAILY_CONTRACT_TEST_USD=

# Daily control canary spend cap, in USD (Config)
SPEND_CAP_DAILY_CONTROL_CANARY_USD=

# Daily DataForSEO spend cap, in USD (Config)
SPEND_CAP_DAILY_DATAFORSEO_USD=

# Free report pool for anonymous visitors, in USD (Config)
SPEND_CAP_DAILY_FREE_REPORT_ANONYMOUS_USD=

# Free report share for businesses outside the priority country, in USD (Config)
SPEND_CAP_DAILY_FREE_REPORT_ELSEWHERE_USD=

# Daily free report spend cap, in USD (Config)
SPEND_CAP_DAILY_FREE_REPORT_USD=

# Free report pool for verified visitors, in USD (Config)
SPEND_CAP_DAILY_FREE_REPORT_VERIFIED_USD=

# Daily Gemini API spend cap, in USD (Config)
SPEND_CAP_DAILY_GEMINI_USD=

# Daily spend cap across every provider, in USD (Config)
SPEND_CAP_DAILY_GLOBAL_USD=

# Daily Google Places spend cap, in USD (Config)
SPEND_CAP_DAILY_GOOGLE_PLACES_USD=

# Daily OpenAI spend cap, in USD (Config)
SPEND_CAP_DAILY_OPENAI_USD=

# Daily quality canary spend cap, in USD (Config)
SPEND_CAP_DAILY_QUALITY_CANARY_USD=

# Daily xAI spend cap, in USD (Config)
SPEND_CAP_DAILY_XAI_USD=
