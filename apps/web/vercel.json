{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "regions": ["iad1"],
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 10 * * *" },
    { "path": "/api/cron/evidence-hourly", "schedule": "0 * * * *" }
  ]
}
