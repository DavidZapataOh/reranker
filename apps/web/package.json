{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "vitest run --project unit --project component --coverage --passWithNoTests && node --test scripts/*.test.mjs",
    "test:integration": "vitest run --project integration && pnpm run test:workflow",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "test:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@posthog/next": "catalog:",
