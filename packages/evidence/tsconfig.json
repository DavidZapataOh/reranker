{
  "extends": "@reranker/typescript-config/library.json",
  "compilerOptions": {
    // The web app compiles this package with DOM's fetch types, which are stricter than Node's.
    "lib": ["es2024", "dom", "dom.iterable"],
    // @reranker/testing is consumed from source and imports its siblings with .ts extensions.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "scripts"]
}
