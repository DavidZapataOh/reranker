    "@reranker/i18n": "workspace:*",
    "@reranker/jobs": "workspace:*",
    "@reranker/schema": "workspace:*",
    "@reranker/telemetry": "workspace:*",
    "@reranker/verify": "workspace:*",
    "@vercel/oidc-aws-credentials-provider": "catalog:",
    "aws4fetch": "catalog:",
    "drizzle-orm": "catalog:",
    "server-only": "catalog:",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudtrail": "catalog:",
    "@aws-sdk/client-iam": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sts": "catalog:",
    "@noble/curves": "catalog:",
    "@reranker/testing": "workspace:*",
    "@reranker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
