{
  "name": "@reranker/evidence",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/jobs.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./jobs": "./src/jobs.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --coverage --passWithNoTests",
