{
  "name": "@reranker/telemetry",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./digest": "./src/digest.ts",
    "./scrub": "./src/scrub.ts",
    "./posthog-rest": "./src/posthog-rest.ts",
    "./posthog-plan": "./src/posthog-plan.ts",
    "./launch": "./src/launch/index.ts"
  },
  "scripts": {
    "alerts:apply": "tsx scripts/apply-alerts.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "runbooks:check": "tsx scripts/runbooks-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --coverage --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:contract": "vitest run --project contract"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "catalog:",
    "@aws-sdk/client-kms": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@reranker/analytics": "workspace:*",
    "@reranker/db": "workspace:*",
    "@reranker/env": "workspace:*",
    "@reranker/i18n": "workspace:*",
    "@reranker/schema": "workspace:*",
    "@reranker/verify": "workspace:*",
    "@vercel/oidc-aws-credentials-provider": "catalog:",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "posthog-node": "catalog:",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@reranker/testing": "workspace:*",
    "@reranker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "msw": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
