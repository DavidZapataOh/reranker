{
  "name": "@reranker/catalog",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./env": "./src/generate/env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --coverage --passWithNoTests && vitest run --project heavy",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "geo:build": "tsx scripts/build-geo.ts",
    "record:generation": "tsx scripts/record-generation.ts",
    "seed:build": "tsx scripts/build-seed.ts",
    "seed:rejudge": "tsx scripts/rejudge-seed.ts",
    "seed:review": "tsx scripts/review-sample.ts",
    "seed:review-native": "tsx scripts/review-native.ts",
    "nouns:build": "tsx scripts/build-nouns.ts",
    "freeze": "tsx scripts/freeze.ts",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@google/genai": "catalog:",
    "@reranker/db": "workspace:*",
    "@reranker/env": "workspace:*",
    "@reranker/evidence": "workspace:*",
    "@reranker/flags": "workspace:*",
    "@reranker/i18n": "workspace:*",
    "@reranker/jobs": "workspace:*",
    "@reranker/schema": "workspace:*",
    "@reranker/stats": "workspace:*",
    "@reranker/telemetry": "workspace:*",
    "@reranker/verify": "workspace:*",
    "canonicalize": "catalog:",
    "drizzle-orm": "catalog:",
    "openai": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@reranker/testing": "workspace:*",
    "@reranker/typescript-config": "workspace:*",
    "@stdlib/stats-base-dists-chisquare-cdf": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "csv-parse": "catalog:",
    "fast-check": "catalog:",
    "fflate": "catalog:",
    "msw": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
