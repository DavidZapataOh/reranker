{
  "name": "@reranker/capture",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./brightdata/env": "./src/brightdata/env.ts",
    "./openai/env": "./src/openai/env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --coverage --passWithNoTests",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "record:live": "tsx --conditions=react-server scripts/record-live.ts",
    "record:brightdata": "tsx --conditions=react-server scripts/record-brightdata.ts",
    "record:phrasing": "tsx --conditions=react-server scripts/record-phrasing.ts",
    "record:language": "tsx --conditions=react-server scripts/record-language.ts",
    "analyze:language": "tsx --conditions=react-server scripts/analyze-language.ts"
  },
  "dependencies": {
    "@reranker/catalog": "workspace:*",
    "@reranker/db": "workspace:*",
    "@reranker/env": "workspace:*",
    "@reranker/evidence": "workspace:*",
    "@reranker/flags": "workspace:*",
    "@reranker/i18n": "workspace:*",
    "@reranker/jobs": "workspace:*",
    "@reranker/schema": "workspace:*",
    "@reranker/telemetry": "workspace:*",
    "@reranker/verify": "workspace:*",
    "dataforseo-client": "catalog:",
    "drizzle-orm": "catalog:",
    "openai": "catalog:",
    "server-only": "catalog:",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@reranker/testing": "workspace:*",
    "@reranker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "msw": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
