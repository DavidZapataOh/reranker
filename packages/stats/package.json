{
  "name": "@reranker/stats",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./methodology": "./src/methodology.ts",
    "./persist": "./src/persist.ts",
    "./telemetry": "./src/telemetry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --coverage --passWithNoTests && vitest run --project heavy",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@reranker/db": "workspace:*",
    "@reranker/schema": "workspace:*",
    "@reranker/telemetry": "workspace:*",
    "@stdlib/stats-base-dists-beta-quantile": "catalog:",
    "canonicalize": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace": "catalog:",
    "@reranker/i18n": "workspace:*",
    "@reranker/typescript-config": "workspace:*",
    "@stdlib/stats-base-dists-beta-cdf": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
