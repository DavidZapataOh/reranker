{
  "name": "reranker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:contract": "turbo run test:contract",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "secrets:audit": "pnpm --filter @reranker/env exec tsx scripts/audit-github-secrets.ts",
    "env:example": "pnpm --filter @reranker/env exec tsx src/example.ts",
    "licenses:check": "node tools/licenses-check/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "lefthook": "catalog:",
    "vitest": "catalog:"
  }
}
