{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  timezone: "America/Bogota",
  schedule: ["before 6am on monday"],
  minimumReleaseAge: "3 days",
  // ci runs on pull requests only, so the PR must exist for its checks to gate automerge.
  prCreation: "immediate",
  platformAutomerge: false,
  packageRules: [
    // Later rules win: runtime updates are grouped and never automerge, tooling overrides below.
    { matchUpdateTypes: ["minor", "patch"], groupName: "non-major dependencies" },
    {
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["devDependencies"],
      groupName: "tooling",
      automerge: true,
    },
    {
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["pnpm.catalog.default"],
      matchPackageNames: ["@biomejs/biome", "turbo", "lefthook", "typescript", "@types/**"],
      groupName: "tooling",
      automerge: true,
    },
    { matchManagers: ["github-actions"], matchUpdateTypes: ["pinDigest"], automerge: true },
    // 2.2.2 was published by hand without the provenance 2.2.1 had, and pnpm's trust policy
    // refuses it; wait for a release published from CI again.
    { matchPackageNames: ["lefthook"], allowedVersions: "!/^2\\.2\\.2$/" },
    // Runner upgrades are deliberate decisions, not bot PRs.
    { matchDatasources: ["github-runners"], enabled: false },
  ],
}
