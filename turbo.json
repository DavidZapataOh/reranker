{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "strict",
  "globalDependencies": ["packages/typescript-config/*.json", "vitest.config.ts"],
  "globalPassThroughEnv": ["COREPACK_HOME"],
  "remoteCache": { "signature": true },
  "futureFlags": { "longerSignatureKey": true },
  "tasks": {
    "//#check": {},
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "build:json-schema": {
      "inputs": ["src/**", "scripts/**", "$TURBO_ROOT$/packages/i18n/src/**"],
      "outputs": ["json-schema/**"]
    },
    "web#build": {
      "dependsOn": ["^build", "@reranker/schema#build:json-schema"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "APP_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "POSTHOG_PROJECT_TOKEN",
        "POSTHOG_HOST",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_API_KEY",
        "POSTHOG_QUERY_READ_KEY",
        "OPS_ALERT_EMAIL",
        "LOG_LEVEL",
        "BETTERSTACK_HEARTBEAT_DAILY_URL",
        "GITHUB_BILLING_READ_TOKEN"
      ],
      "passThroughEnv": ["ENABLE_EXPERIMENTAL_COREPACK"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "web#typecheck": { "dependsOn": ["^typecheck"], "env": ["APP_ENV"] },
    "test": { "dependsOn": ["^typecheck"], "outputs": ["coverage/**"] },
    "@reranker/ui#test": { "dependsOn": ["^typecheck"], "outputs": [] },
    "@reranker/biome-plugins#test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.jsonc", "$TURBO_ROOT$/tools/biome/**"]
    },
    "test:integration": {
      "dependsOn": ["^typecheck"],
      "env": ["DATABASE_URL", "DATABASE_URL_SYSTEM", "DATABASE_URL_MIGRATIONS"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/db/migrations/**"]
    },
    "@reranker/db#test:integration": {
      "dependsOn": ["^typecheck"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_SYSTEM",
        "DATABASE_URL_MIGRATIONS",
        "NEON_API_KEY",
        "NEON_PROJECT_ID",
        "NEON_NONPROD_PROJECT_ID"
      ],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:contract": {
      "dependsOn": ["^typecheck"],
      "cache": false,
      "env": [
        "DATAFORSEO_LOGIN",
        "DATAFORSEO_PASSWORD",
        "BRIGHTDATA_API_KEY_CI",
        "OPENAI_API_KEY_CI",
        "GEMINI_API_KEY",
        "GOOGLE_PLACES_API_KEY_CI",
        "ANTHROPIC_API_KEY_CI",
        "XAI_API_KEY_CI",
        "RESEND_API_KEY",
        "NEON_API_KEY"
      ]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
