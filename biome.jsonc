{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!.claude",
      "!**/next-env.d.ts",
      "!.impeccable",
      "!assets",
      "!**/public",
      "!**/*.md",
      "!packages/schema/json-schema"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended",
      "drizzle": "recommended"
    },
    "rules": {
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" },
      // A component prop named role (a chat bubble's speaker) is not an ARIA role.
      "a11y": { "useValidAriaRole": { "level": "error", "options": { "ignoreNonDom": true } } }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.contract.test.ts"],
      "linter": { "rules": { "suspicious": { "noSkippedTests": "error" } } }
    },
    // An override's noRestrictedImports options replace those of earlier matching overrides
    // instead of merging, so every block that restricts other imports repeats the zod rule.
    {
      "includes": ["**", "!packages/schema/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import z from @reranker/schema, which configures zod.",
                  "@reranker/db/auth-adapter": "The connection without tenant or system settings is only for packages/auth."
                },
                "patterns": [
                  {
                    "group": ["zod/*"],
                    "message": "Import z from @reranker/schema, which configures zod."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "packages/*/src/**",
        "!packages/testing/**",
        "!packages/schema/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@reranker/testing": "Test-only package.",
                  "zod": "Import z from @reranker/schema, which configures zod.",
                  "@reranker/db/auth-adapter": "The connection without tenant or system settings is only for packages/auth."
                },
                "patterns": [
                  {
                    "group": ["@reranker/testing/*", "**/testing/src/**"],
                    "message": "Test-only package."
                  },
                  {
                    "group": ["zod/*"],
                    "message": "Import z from @reranker/schema, which configures zod."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/schema/src/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@reranker/testing": "Test-only package.",
                  "@reranker/db/auth-adapter": "The connection without tenant or system settings is only for packages/auth."
                },
                "patterns": [
                  {
                    "group": ["@reranker/testing/*", "**/testing/src/**"],
                    "message": "Test-only package."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/schema/**/*.test.ts", "packages/schema/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@reranker/db/auth-adapter": "The connection without tenant or system settings is only for packages/auth."
                }
              }
            }
          }
        }
      }
    },
    // packages/auth is the one consumer of the auth adapter; these blocks restate the other
    // restrictions without it.
    {
      "includes": ["packages/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": { "zod": "Import z from @reranker/schema, which configures zod." },
                "patterns": [
                  {
                    "group": ["zod/*"],
                    "message": "Import z from @reranker/schema, which configures zod."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/auth/src/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@reranker/testing": "Test-only package.",
                  "zod": "Import z from @reranker/schema, which configures zod."
                },
                "patterns": [
                  {
                    "group": ["@reranker/testing/*", "**/testing/src/**"],
                    "message": "Test-only package."
                  },
                  {
                    "group": ["zod/*"],
                    "message": "Import z from @reranker/schema, which configures zod."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "plugins": [
    // Covers tests too: a dynamic sql.raw is an injection path wherever it runs.
    {
      "path": "./tools/biome/no-dynamic-sql-raw.grit",
      "includes": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"]
    },
    {
      "path": "./tools/biome/no-conditional-contract-tests.grit",
      "includes": ["**/*.contract.test.ts"]
    },
    {
      "path": "./tools/biome/no-country-literals.grit",
      "includes": [
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!packages/i18n/src/countries/**",
        "!packages/i18n/src/locales.ts",
        "!packages/schema/src/country.ts",
        "!**/*.test.{ts,tsx}",
        "!**/e2e/**"
      ]
    }
  ]
}
